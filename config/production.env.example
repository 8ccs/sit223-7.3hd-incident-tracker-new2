# Example environment file for PRODUCTION. This is what
# scripts/deploy.ps1 generates automatically at C:\devops-demo\production\current.env
# (not committed to git). The app itself has no secrets of its own --
# notification credentials belong to the monitoring stack instead, see
# monitoring/secrets/slack_webhook_url.example.
APP_ENV=production
PORT=5000
DB_PATH=C:\devops-demo\production\data\incidents.db
