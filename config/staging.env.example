# Example environment file for STAGING. This is what
# scripts/deploy.ps1 generates automatically at C:\devops-demo\staging\current.env
# (not committed to git). The app itself has no secrets of its own --
# notification credentials belong to the monitoring stack instead, see
# monitoring/secrets/slack_webhook_url.example.
APP_ENV=staging
PORT=5001
DB_PATH=C:\devops-demo\staging\data\incidents.db
