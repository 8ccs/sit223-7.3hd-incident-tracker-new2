# Python
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.venv/
venv/

# Build/test/scan output (regenerated by the pipeline every run)
dist/
reports/
evidence/*.png
evidence/*.jpg

# Local data and environment files (never commit real deployment config)
data/
*.db
*.env
!config/*.env.example

# Monitoring runtime output
monitoring/alerts_received.log

# Real notification-channel secrets (never commit; see
# monitoring/secrets/slack_webhook_url.example for the safe placeholder)
monitoring/secrets/*
!monitoring/secrets/*.example

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/
